// Kargovo DM Asistanı — Prisma Şeması
// Bu şema PostgreSQL için tasarlanmıştır. Gerçek bir veritabanına bağlanmak için
// kök dizindeki .env dosyasında DATABASE_URL değişkenini tanımlayın,
// ardından `npx prisma migrate dev` komutunu çalıştırın.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Kimlik doğrulama (Auth.js / NextAuth uyumlu modeller)
// ----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  OPERATOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// bcrypt ile hashlenmiş parola. Hiçbir zaman düz metin saklanmaz.
  passwordHash  String?
  role          UserRole  @default(OPERATOR)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  auditLogs      AuditLog[]
  reviewedLogs   AIResponseLog[] @relation("ReviewedBy")
  sentMessages   Message[]       @relation("SentByUser")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------------
// Instagram entegrasyonu
// ----------------------------------------------------------------------------

enum InstagramConnectionStatus {
  DISCONNECTED
  DEMO
  CONNECTED
  ERROR
}

model InstagramAccount {
  id         String                     @id @default(cuid())
  igUserId   String?                    @unique
  username   String?
  pageId     String?
  /// Erişim token'ı şifrelenmiş biçimde saklanır, istemciye asla gönderilmez.
  accessTokenEnc String?
  tokenExpiresAt DateTime?
  status         InstagramConnectionStatus @default(DISCONNECTED)
  isDemo         Boolean                   @default(true)
  lastSyncAt     DateTime?
  lastErrorMessage String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  conversations Conversation[]
}

// ----------------------------------------------------------------------------
// Müşteriler ve konuşmalar
// ----------------------------------------------------------------------------

model Customer {
  id         String   @id @default(cuid())
  igUsername String?
  name       String?
  avatarUrl  String?
  phone      String?
  email      String?
  notes      String?  @db.Text
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  conversations Conversation[]
  orders        Order[]

  @@index([igUsername])
  @@index([phone])
}

enum ConversationStatus {
  WAITING
  REPLIED
  IMPORTANT
}

model Conversation {
  id                 String              @id @default(cuid())
  instagramAccountId String
  customerId         String
  status             ConversationStatus  @default(WAITING)
  isUnread           Boolean             @default(true)
  autoReplyEnabled   Boolean             @default(true)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  isDemo             Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages         Message[]
  aiResponseLogs   AIResponseLog[]

  @@index([status])
  @@index([lastMessageAt])
  @@index([instagramAccountId])
}

enum MessageSender {
  CUSTOMER
  AGENT
  AI
  SYSTEM
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  content        String        @db.Text
  isAiGenerated  Boolean       @default(false)
  isDemo         Boolean       @default(false)
  /// Meta tarafından verilen mesaj kimliği — webhook idempotency için kullanılır.
  igMessageId    String?       @unique
  sentByUserId   String?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentByUser   User?         @relation("SentByUser", fields: [sentByUserId], references: [id])

  @@index([conversationId, createdAt])
}

// ----------------------------------------------------------------------------
// Siparişler ve kargo
// ----------------------------------------------------------------------------

enum OrderStatus {
  PREPARING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String
  productInfo String      @db.Text
  totalAmount Decimal?    @db.Decimal(10, 2)
  status      OrderStatus @default(PREPARING)
  isDemo      Boolean     @default(false)
  orderDate   DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shipment Shipment?

  @@index([status])
  @@index([orderNumber])
  @@index([customerId])
}

model Shipment {
  id             String   @id @default(cuid())
  orderId        String   @unique
  cargoCompany   String
  trackingNumber String?
  trackingUrl    String?
  isDemo         Boolean  @default(false)
  shippedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// Bilgi bankası
// ----------------------------------------------------------------------------

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  isActive  Boolean  @default(true)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

enum KnowledgeBaseCategory {
  PRODUCT
  SHIPPING
  RETURNS
  PAYMENT
  HOURS
  CONTACT
  OTHER
}

model KnowledgeBaseEntry {
  id        String                @id @default(cuid())
  category  KnowledgeBaseCategory
  title     String
  content   String                @db.Text
  isActive  Boolean               @default(true)
  isDemo    Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([category])
  @@index([isActive])
}

// ----------------------------------------------------------------------------
// Otomasyon ayarları
// ----------------------------------------------------------------------------

model AutomationSettings {
  id                        String   @id @default(cuid())
  aiAssistantEnabled        Boolean  @default(true)
  autoReplyEnabled          Boolean  @default(false)
  requireApprovalBeforeSend Boolean  @default(true)
  workingHoursStart         String   @default("09:00")
  workingHoursEnd           String   @default("18:00")
  welcomeMessage            String?  @db.Text
  handoffRules              String?  @db.Text
  aiTone                    String   @default("profesyonel")
  updatedAt                 DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Yapay zekâ yanıt kayıtları
// ----------------------------------------------------------------------------

enum AIIntent {
  SHIPPING
  DELIVERY
  RETURN
  PRODUCT
  PAYMENT
  ORDER_STATUS
  OTHER
  UNKNOWN
}

model AIResponseLog {
  id               String   @id @default(cuid())
  conversationId   String
  messageId        String?
  intent           AIIntent @default(UNKNOWN)
  confidence       Float?
  suggestedReply   String   @db.Text
  wasSent          Boolean  @default(false)
  wasEdited        Boolean  @default(false)
  requiresHuman    Boolean  @default(false)
  reviewedByUserId String?
  createdAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("ReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([conversationId])
  @@index([intent])
}

// ----------------------------------------------------------------------------
// Denetim kaydı
// ----------------------------------------------------------------------------

enum AuditAction {
  LOGIN
  LOGOUT
  SETTINGS_UPDATE
  ORDER_UPDATE
  MESSAGE_SEND
  KB_UPDATE
  INTEGRATION_UPDATE
  USER_UPDATE
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  details   String?     @db.Text
  ipAddress String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
}
